{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/secret-check.sh\"",
            "timeout": 20,
            "onFailure": "block",
            "statusMessage": "Checking for secrets before git commit/push…"
          }
        ]
      }
    ]
  }
}
